---
import { AppToaster, BottomTab, FlashToast, NativeExitDialog } from '@dearbloom/ui';

interface Props {
  title: string;
  navVariant?: 'light' | 'dark';
}
const { title, navVariant = 'light' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      if (window.__DEARBLOOM_NATIVE_APP__?.platform) {
        document.documentElement.style.setProperty('--dearbloom-safe-area-bottom', '0px');
      }
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- font-sans(= Pretendard) 실체. dynamic subset 이라 실제 쓰인 글자만 내려받습니다. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{title} · dearBloom</title>
  </head>
  <body class="min-h-screen bg-neutral-100 pb-20 font-sans text-neutral-950">
    <slot />
    {/* 훅·이벤트 핸들러가 없는 순수 마크업(링크 4개)이라 client 디렉티브 없이
        서버 렌더 HTML 로만 끝냅니다 — 아일랜드로 두면 하이드레이션 비용만 듭니다. */}
    <BottomTab currentPath={currentPath} variant={navVariant} />
    <AppToaster client:load />
    <FlashToast client:load />
    <NativeExitDialog client:load />
  </body>
</html>
