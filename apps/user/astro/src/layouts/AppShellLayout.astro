---
import { BottomTab, ScrollFade } from '@dearbloom/ui';

interface Props {
  title: string;
  navVariant?: 'light' | 'dark';
}
const { title, navVariant = 'light' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- font-sans(= Pretendard) 실체. dynamic subset 이라 실제 쓰인 글자만 내려받습니다. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{title} · dearBloom</title>
  </head>
  <body class="min-h-screen bg-neutral-100 pb-20 font-sans text-neutral-950">
    <slot />
    {/* 하단탭(60px) 바로 위에 깔리는 스크롤 페이드 — 더 볼 게 남았을 때만 보입니다. */}
    <ScrollFade offset={60} client:load />
    <BottomTab currentPath={currentPath} variant={navVariant} client:load />
  </body>
</html>
