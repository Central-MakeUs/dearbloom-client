---
import SeoHead from '@/components/SeoHead.astro';
import { AppToaster, BottomTab, NativeExitDialog } from '@dearbloom/ui';

interface Props {
  title: string;
  /** 검색 결과·공유 미리보기 설명. 비우면 사이트 기본 설명 */
  description?: string;
  jsonLd?: Record<string, unknown>;
  navVariant?: 'light' | 'dark';
}
const { title, description, jsonLd, navVariant = 'light' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 검색엔진 소유확인 (Google Search Console · 네이버 서치어드바이저). 삭제하면 인증이 풀립니다. -->
    <meta name="google-site-verification" content="xgTyUqg1cTn1eU4vMC_7cHiIPJzf5Sdhvl2kSDvSLLQ" />
    <meta name="naver-site-verification" content="24bb7edd824f16fda679ca2ec9448ff493642547" />
    <script is:inline>
      if (window.__DEARBLOOM_NATIVE_APP__?.platform) {
        document.documentElement.style.setProperty('--dearbloom-safe-area-bottom', '0px');
      }
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- font-sans(= Pretendard) 실체. dynamic subset 이라 실제 쓰인 글자만 내려받습니다. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <SeoHead title={title} description={description} jsonLd={jsonLd} />
  </head>
  <body class="min-h-screen bg-neutral-100 pb-20 font-sans text-neutral-950">
    <slot />
    {/* 훅·이벤트 핸들러가 없는 순수 마크업(링크 4개)이라 client 디렉티브 없이
        서버 렌더 HTML 로만 끝냅니다 — 아일랜드로 두면 하이드레이션 비용만 듭니다. */}
    <BottomTab currentPath={currentPath} variant={navVariant} />
    <AppToaster client:load />
    {/* 앱 종료 확인 — RN WebView 안에서만 의미가 있어 client:native (브라우저엔 JS 를 안 보냄). */}
    <NativeExitDialog client:native />
  </body>
</html>
