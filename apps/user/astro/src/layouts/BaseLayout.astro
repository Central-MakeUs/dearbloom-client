---
import { ScrollFade } from '@dearbloom/ui';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- font-sans(= Pretendard) 실체. dynamic subset 이라 실제 쓰인 글자만 내려받습니다. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{title} · dearBloom</title>
  </head>
  <body class="font-sans text-ink p-10">
    <slot />
    {/* 하단 고정 요소가 없는 화면이라 바닥에 바로 붙입니다. 장식이라 client:idle. */}
    <ScrollFade client:idle />
  </body>
</html>
