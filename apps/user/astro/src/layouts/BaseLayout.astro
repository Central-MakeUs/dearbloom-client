---
import { NativeExitDialog } from '@dearbloom/ui';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 검색엔진 소유확인 (Google Search Console · 네이버 서치어드바이저). 삭제하면 인증이 풀립니다. -->
    <meta name="google-site-verification" content="xgTyUqg1cTn1eU4vMC_7cHiIPJzf5Sdhvl2kSDvSLLQ" />
    <meta name="naver-site-verification" content="24bb7edd824f16fda679ca2ec9448ff493642547" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- font-sans(= Pretendard) 실체. dynamic subset 이라 실제 쓰인 글자만 내려받습니다. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{title} · DearBloom</title>
  </head>
  <body class="font-sans text-ink p-10">
    <slot />
    {/* 앱 종료 확인 — RN WebView 안에서만 의미가 있어 client:native (브라우저엔 JS 를 안 보냄). */}
    <NativeExitDialog client:native />
  </body>
</html>
