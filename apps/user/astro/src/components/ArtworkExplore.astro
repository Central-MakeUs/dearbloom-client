---
/*
  작품 탐색 본문 — 필터 칩바·개수/정렬·작품 피드. /snaps·/region/*·/ 가 함께 씁니다.
  데이터와 캐시 헤더는 페이지가 lib/artworkExplore 로 준비해 넘깁니다(헤더는 렌더 전에 정해야 해서).
  기본 slot 은 칩바 위(지역·홈 랜딩의 H1·소개)에 그립니다.
*/
import type { ArtworkListParams, ArtworkPage } from '@dearbloom/shared';
import { ArtworkFeed } from '@/components/ArtworkFeed';
import { ArtworkSortSheet } from '@/components/ArtworkSortSheet';
import ViewToggleIcon from '@/components/ViewToggleIcon.astro';
import { toIslandPage } from '@/lib/artworkExplore';
import {
  filterChipLabels,
  hasActiveFilter,
  toQueryString,
  toSearchParams,
  type ArtworkView,
} from '@/lib/artworkFilter';

interface Props {
  page: ArtworkPage;
  loadFailed: boolean;
  filter: ArtworkListParams;
  view: ArtworkView;
  /** 정렬·보기 전환 후 머무를 경로. 지역 랜딩은 자기 경로를 넘기고, 지역은 경로에 담겨 쿼리에서 뺍니다. */
  basePath?: string;
}
const { page, loadFailed, filter, view, basePath = '/snaps' } = Astro.props;

// 지역 랜딩에선 지역이 경로(/region/서울)에 있으므로 이 화면 안의 링크 쿼리에서는 뺀다.
const pathFilter: ArtworkListParams = basePath === '/snaps' ? filter : { ...filter, region: undefined };

const islandPage = toIslandPage(page, view);
const chips = filterChipLabels(filter);
const hasFilter = hasActiveFilter(filter);
const query = toQueryString(filter); // ArtworkFeed 가 다음 페이지 요청에 싣는다(view 는 조회 조건이 아니라 제외)
const filterHref = `/snaps/filter${toQueryString(filter, view)}`;
// 정렬 시트는 정렬만 갈아끼우므로, 정렬을 뺀 나머지(보기 방식 포함)를 넘긴다.
const filterOnlyQuery = toSearchParams({ ...pathFilter, sort: undefined }, view).toString();

const CHIP_CLASS =
  'flex h-8 shrink-0 items-center gap-0.5 rounded-[6px] border border-neutral-400 bg-neutral-100 py-1 pl-2 pr-0.5 text-body-5 text-neutral-800';
---

<div class="mx-auto max-w-md">
  <slot />

  <div class="sticky top-[calc(44px+env(safe-area-inset-top))] z-30 bg-neutral-100">
  {/*
    필터 칩바 — Figma 437:7705. 어느 칩을 눌러도 필터 설정으로 가고, 해시로 해당 섹션에 붙는다.
    세로 위치는 실측(상태바 제외): 헤더 하단 44 → 칩바 52~84 → 정렬행 87~127 → 그리드 129.
  */}
  <div class="flex items-center gap-1 overflow-x-auto px-4 pt-2">
    <a
      href={filterHref}
      aria-label="필터 설정"
      class="flex h-8 w-[34px] shrink-0 items-center justify-center rounded-[6px] border border-neutral-400 bg-neutral-100"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" class="text-neutral-700" aria-hidden="true">
        <path d="M3 6h11M18 6h3M3 12h3M10 12h11M3 18h11M18 18h3" />
        <circle cx="16" cy="6" r="2" /><circle cx="8" cy="12" r="2" /><circle cx="16" cy="18" r="2" />
      </svg>
    </a>

    {[
      // 날짜는 첫 섹션이라 해시 없이 들어가면 그대로 맨 위 — 탭바 아래로 어중간하게 내려가지 않는다.
      { href: filterHref, label: chips.date },
      { href: `${filterHref}#region`, label: chips.region },
      { href: `${filterHref}#headCount`, label: chips.headCount },
    ].map((chip) => (
      <a href={chip.href} class={CHIP_CLASS}>
        {chip.label}
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"
          stroke-linecap="round" stroke-linejoin="round" class="text-neutral-700" aria-hidden="true">
          <path d="m8 10 4 4 4-4" />
        </svg>
      </a>
    ))}
  </div>

  {/* 전체 개수 + 정렬 — Figma 1035:11052 / 443:9624. 좌 20 / 우 8 은 시안 실측값. */}
  {!loadFailed && (
    <div class="mb-0.5 mt-[3px] flex h-10 items-center justify-between pl-5 pr-2">
      <span class="text-body-5 text-neutral-600">전체 {page.totalCount}</span>
      <div class="flex items-center">
        {/* 정렬은 보조 조작 — 첫 렌더를 막지 않고 유휴 시간에 붙인다. */}
        <ArtworkSortSheet
          current={filter.sort ?? 'LATEST'}
          filterQuery={filterOnlyQuery}
          basePath={basePath}
          client:idle
        />
        {/*
          보기 전환 — Figma icons/40/3Grid. 그리드일 땐 점 3x3, 리스트일 땐 2x2(시안 1060:16189).
          누르면 바뀔 상태가 아니라 "지금 무엇으로 갈 수 있는지"를 아이콘으로 보여준다.
        */}
        <a
          href={`${basePath}${toQueryString(pathFilter, view === 'list' ? 'grid' : 'list')}`}
          aria-label={view === 'list' ? '격자로 보기' : '리스트로 보기'}
          class="flex h-10 w-10 items-center justify-center text-neutral-800"
        >
          <ViewToggleIcon view={view} />
        </a>
      </div>
    </div>
  )}
  </div>

  {/* 작품 피드 */}
  {loadFailed ? (
    <p class="px-4 py-16 text-center text-body-4 text-neutral-500">작품을 불러오지 못했어요. 잠시 후 다시 시도해주세요.</p>
  ) : page.artworkList.length === 0 ? (
    <div class="px-4 py-16 text-center">
      <p class="text-body-4 text-neutral-500">
        {hasFilter ? '조건에 맞는 작품이 없어요.' : '아직 등록된 작품이 없어요.'}
      </p>
      {hasFilter && (
        <a href={`/snaps${toQueryString({}, view)}`} class="mt-3 inline-block rounded-md border border-neutral-400 px-4 py-2 text-body-5 text-neutral-800">
          필터 초기화
        </a>
      )}
    </div>
  ) : (
    <ArtworkFeed initialPage={islandPage} query={query} selectedRegion={filter.region} view={view} client:load />
  )}
</div>
