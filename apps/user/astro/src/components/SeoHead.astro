---
/*
  레이아웃 공통 SEO 태그 — title·description·canonical·OG.
  작품 상세(/snaps/[slug])는 작품별 OG 이미지가 있어 자체 <head> 를 씁니다.
*/
import { DEFAULT_DESCRIPTION, SITE_NAME, SITE_URL } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  /** 구조화 데이터(schema.org). 검색 결과에 사이트명·이동경로 등을 붙이는 데 씁니다. */
  jsonLd?: Record<string, unknown>;
}
const { title, description = DEFAULT_DESCRIPTION, jsonLd } = Astro.props;
const fullTitle = `${title} · ${SITE_NAME}`;
// JSON 안의 '<' 를 이스케이프해 문자열 값이 </script> 로 태그를 닫지 못하게 한다.
const jsonLdHtml = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).toString();
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta name="twitter:card" content="summary" />
{jsonLdHtml && <script type="application/ld+json" set:html={jsonLdHtml} />}
