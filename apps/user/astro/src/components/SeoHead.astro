---
/*
  공통 SEO 태그 — title·description·canonical·OG·robots·구조화 데이터.
  레이아웃뿐 아니라 자체 <head> 를 쓰는 작품 상세·이미지 화면도 이 컴포넌트를 씁니다.
*/
import { DEFAULT_DESCRIPTION, SITE_NAME, SITE_URL } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  /** 공유 미리보기 이미지(절대 URL). 있으면 큰 카드로 보입니다. */
  image?: string;
  /**
   * canonical 경로. 비우면 요청 경로를 씁니다.
   * 같은 콘텐츠가 여러 경로로 들어올 수 있으면(/snaps/012 → /snaps/12) 정규 경로를 넘기세요.
   */
  canonicalPath?: string;
  /** 검색 결과에서 뺄 페이지. canonical 은 내보내지 않습니다(noindex 와 상충). */
  noindex?: boolean;
  /** 구조화 데이터(schema.org). 검색 결과에 사이트명·이동경로 등을 붙이는 데 씁니다. */
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  jsonLd,
} = Astro.props;
const fullTitle = `${title} · ${SITE_NAME}`;
// JSON 안의 '<' 를 이스케이프해 문자열 값이 </script> 로 태그를 닫지 못하게 한다.
const jsonLdHtml = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
// Astro.url.origin 은 Vercel 함수 안에서 공개 도메인이 아니라(https://localhost) 정식 주소로 고정한다.
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalUrl} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
{image && <meta property="og:image" content={image} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{jsonLdHtml && <script type="application/ld+json" set:html={jsonLdHtml} />}
