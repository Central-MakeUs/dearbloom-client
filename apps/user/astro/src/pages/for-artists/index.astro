---
/*
  작가 모집 랜딩(/for-artists) — 졸업스냅 작가 사전등록.
  숫자는 꽃잎 정책 v0.4 기준(예약 1건 12꽃잎, 사전등록 100 + 선착순 1,000명 100).
  사전등록은 /api/artist-applications 로 저장되고, /for-artists/admin 에서 관리한다.
*/
import { Banknote, RotateCcw, Star, TrendingUp } from 'lucide-react';
import SeoHead from '@/components/SeoHead.astro';
import { SITE_URL } from '@/lib/site';

const TITLE = '졸업스냅 작가 사전등록';
const DESCRIPTION =
  '디어블룸에 졸업스냅 작품을 올리고 문의를 무료로 받아 보세요. 2027년 1월 말 오픈, 사전등록 작가에게 예약 16건 분량의 꽃잎을 드려요.';

const PETALS_TOTAL = 200;
const PETALS_PER_BOOKING = 12;
const FREE_BOOKINGS = Math.floor(PETALS_TOTAL / PETALS_PER_BOOKING); // 16

const screens = [
  { src: '/for-artists/explore.jpg', label: '탐색에 작품 노출', alt: '졸업스냅 작품이 사진과 가격, 지역으로 나열된 탐색 화면' },
  { src: '/for-artists/chat.jpg', label: '정리된 문의 채팅', alt: '날짜, 시간, 인원, 학교가 정리된 문의 카드가 도착한 채팅 화면' },
  { src: '/for-artists/requests.jpg', label: '신청 관리', alt: '진행중, 예약완료 상태로 나뉜 신청 관리 화면' },
  { src: '/for-artists/schedule.jpg', label: '촬영 가능 시간', alt: '달력에서 날짜를 고르고 30분 단위로 촬영 가능 시간을 여닫는 일정 관리 화면' },
];

const benefits = [
  { who: '사전등록 작가', amount: '100', note: '예약 8건' },
  { who: '선착순 1,000명 추가', amount: '+100', note: '합계 200꽃잎 · 예약 16건', highlight: true },
  { who: '오픈 후 3개월 안에 가입', amount: '50', note: '예약 4건' },
  { who: '작가 추천 (추천한 분, 받은 분 각각)', amount: '30', note: '예약 2건' },
];

const steps = [
  { title: '고객이 문의를 보내요', body: '날짜, 시간, 인원, 학교가 정리된 문의가 도착하고 채팅방이 열려요.', cost: '꽃잎 0장' },
  { title: '채팅으로 일정을 맞춰요', body: '콘셉트, 장소, 소품을 편하게 이야기하세요. 몇 번을 주고받아도 무료예요.', cost: '꽃잎 0장' },
  { title: '[예약 완료]를 눌러요', body: '일정이 확정되면 그 시간이 스케줄에서 자동으로 막히고, 리뷰를 받을 수 있게 돼요.', cost: `${PETALS_PER_BOOKING}꽃잎`, spend: true },
];

const promises = [
  { Icon: RotateCcw, title: '노쇼와 고객 취소는 돌려드려요', body: '고객이 앱에서 취소하거나 촬영 전날까지 취소하면 12꽃잎이 그대로 돌아와요.' },
  { Icon: Banknote, title: '충전한 꽃잎은 환불돼요', body: '쓰고 남은 충전 꽃잎은 충전했던 금액 기준으로 계좌로 돌려드려요.' },
  { Icon: Star, title: '리뷰는 실제 촬영만', body: '촬영이 확인된 예약에만 리뷰가 달려서, 쌓인 리뷰가 그대로 작가님의 신뢰가 돼요.' },
  { Icon: TrendingUp, title: '잘하는 작가님이 먼저 보여요', body: '추천순은 예약 확정률, 리뷰, 응답 속도로 정해져요. 오픈 초기 작가님께는 노출 가산점이 있어요.' },
];

const faqs = [
  {
    q: '꽃잎은 어떻게 충전하나요?',
    a: '필요할 때 1만원, 3만원, 5만원 묶음으로 충전해요. 큰 묶음일수록 꽃잎을 더 드려요(80 / 250 / 430꽃잎). 오픈 혜택을 다 쓰기 전까지는 충전하지 않아도 돼요.',
  },
  { q: '고객도 돈을 내나요?', a: '아니요. 고객은 문의, 채팅, 예약 모두 무료예요. 촬영비는 지금처럼 작가님과 고객이 직접 정해요.' },
  {
    q: '채팅에서 연락처를 주고받을 수 있나요?',
    a: '전화번호, 카카오톡 ID 같은 연락처는 자동으로 가려져요. 플랫폼 밖 거래는 작가님과 고객 모두 보호받을 수 없고, 확인되면 제재가 있어요.',
  },
  {
    q: '예약 완료를 깜빡하면요?',
    a: '촬영일 다음 날 고객에게 촬영 여부를 물어보고, 촬영했다고 하면 자동으로 예약 완료돼요. 이렇게 처리된 건은 환급이 안 되고 예약 확정률에 반영되니 확정되면 바로 눌러 주세요.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: `${TITLE} · DearBloom`,
      description: DESCRIPTION,
      url: new URL('/for-artists', SITE_URL).toString(),
      inLanguage: 'ko',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};

const petal = 'inline-block h-[0.62em] w-[0.62em] shrink-0 -rotate-12 rounded-[70%_0_70%_0] bg-petal';
const sectionCls = 'grid gap-7 border-t border-primary-200 py-12 md:py-20';
const h2Cls = 'text-[1.5rem] font-extrabold leading-snug tracking-[-0.02em] text-balance md:text-[2.1rem]';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <SeoHead title={TITLE} description={DESCRIPTION} canonicalPath="/for-artists" jsonLd={jsonLd} />
  </head>
  <body class="bg-primary-50 font-sans text-primary-900 [word-break:keep-all]">
    <div class="mx-auto max-w-[1040px] px-4">
      <header class="flex items-center justify-between gap-3 py-4">
        <a href="/" class="inline-flex items-center gap-2 text-caption-1 font-semibold text-neutral-700">
          <span class="fa-logo block h-[19px] w-[132px] bg-primary" role="img" aria-label="DearBloom"></span>
          작가
        </a>
        <a
          href="#signup"
          class="inline-flex min-h-11 items-center rounded-lg border border-primary-200 px-5 font-semibold text-primary"
          >사전등록</a
        >
      </header>

      <main>
        <div class="grid items-center gap-8 py-8 md:py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
          <div class="grid min-w-0 gap-5">
            <p class="font-semibold text-primary">2027년 1월 말 오픈 · 지금 작가 사전등록 중</p>
            <h1 class="text-[2rem] font-extrabold leading-tight tracking-[-0.03em] text-balance md:text-[3.3rem]">
              졸업스냅 문의,<br />이제 <span class="whitespace-nowrap">한 곳에서</span>
              <span class="whitespace-nowrap">받으세요.</span>
            </h1>
            <p class="max-w-[34em] text-neutral-700">
              작품을 올려 두면 문의가 오고, 예약이 확정될 때만 꽃잎이 쓰여요. 월 구독도, 등록비도 없어요.
            </p>
            <div class="flex flex-wrap gap-2.5">
              <a href="#signup" class="inline-flex min-h-11 items-center rounded-lg bg-primary px-5 font-semibold text-neutral-0"
                >사전등록하고 {PETALS_TOTAL}꽃잎 받기</a
              >
              <a
                href="#how"
                class="inline-flex min-h-11 items-center rounded-lg border border-primary-200 px-5 font-semibold text-primary"
                >어떻게 쓰이나요?</a
              >
            </div>
            <p class="flex flex-wrap gap-x-5 gap-y-1 text-body-4 text-neutral-700">
              <span>채팅·문의 <b class="text-primary-900">무료</b></span>
              <span>오픈 혜택 최대 {FREE_BOOKINGS}건의 예약 <b class="text-primary-900">무료</b></span>
            </p>
          </div>

          <aside
            class="min-w-0 rounded-lg border border-primary-200 bg-neutral-0 p-5 tabular-nums md:p-6"
            aria-label="꽃잎 내역 예시"
          >
            <p class="flex justify-between text-body-4 font-semibold text-neutral-700">
              <span>내 꽃잎</span><span>예시</span>
            </p>
            <p class="mt-2 flex items-baseline gap-2 text-[2.1rem] font-extrabold tracking-[-0.02em] md:text-[2.6rem]">
              176<small class="text-body-2 font-medium text-neutral-700">꽃잎</small>
            </p>
            <ul class="mt-4 border-t border-dashed border-primary-200">
              <li class="flex justify-between gap-3 border-b border-dashed border-primary-200 py-2.5 text-body-4">
                <span class="text-neutral-700">오픈 혜택 · 사전등록</span><span class="font-semibold text-primary">+100</span>
              </li>
              <li class="flex justify-between gap-3 border-b border-dashed border-primary-200 py-2.5 text-body-4">
                <span class="text-neutral-700">오픈 혜택 · 선착순 1,000명</span><span class="font-semibold text-primary">+100</span>
              </li>
              <li class="flex justify-between gap-3 border-b border-dashed border-primary-200 py-2.5 text-body-4">
                <span class="text-neutral-700">예약 완료 · 2/14 졸업 스냅</span><span class="font-semibold">−12</span>
              </li>
              <li class="flex justify-between gap-3 border-b border-dashed border-primary-200 py-2.5 text-body-4">
                <span class="text-neutral-700">예약 완료 · 2/21 커플 스냅</span><span class="font-semibold">−12</span>
              </li>
            </ul>
          </aside>
        </div>

        <section class={sectionCls} aria-labelledby="screens-title">
          <h2 id="screens-title" class={h2Cls}>작가님 앱은 이렇게 생겼어요</h2>
          <div
            class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-3.5 overflow-x-auto px-4 pb-2 md:mx-0 md:grid md:grid-cols-4 md:gap-5 md:overflow-visible md:px-0"
          >
            {
              screens.map((screen) => (
                <figure class="m-0 grid w-[min(36vw,150px)] shrink-0 snap-start content-start gap-2 md:w-auto md:gap-3">
                  <div class="rounded-[18px] bg-primary-900 p-[5px] shadow-elevation md:rounded-[26px] md:p-[7px]">
                    <img
                      src={screen.src}
                      alt={screen.alt}
                      width="506"
                      height="1100"
                      loading="lazy"
                      decoding="async"
                      class="block aspect-[506/1100] w-full rounded-[14px] bg-neutral-100 object-contain object-top md:rounded-[20px]"
                    />
                  </div>
                  <figcaption class="text-body-3 md:text-body-1 md:font-semibold">{screen.label}</figcaption>
                </figure>
              ))
            }
          </div>
        </section>

        <section class={sectionCls} aria-labelledby="benefit-title">
          <h2 id="benefit-title" class={h2Cls}>먼저 오신 작가님께 예약 {FREE_BOOKINGS}건을 드려요</h2>
          <ul class="border-t-2 border-primary-900 tabular-nums">
            {
              benefits.map((benefit) => (
                <li
                  class:list={[
                    'grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 border-b border-primary-200 px-2 py-3.5 md:grid-cols-[1fr_7em_11em] md:px-3 md:py-[18px]',
                    benefit.highlight && 'bg-primary-100',
                  ]}
                >
                  <span class="font-semibold">{benefit.who}</span>
                  <span class="row-span-2 inline-flex items-center justify-end gap-1 text-[1.4rem] font-extrabold tracking-[-0.02em] md:row-span-1 md:text-[1.6rem]">
                    <i class={petal} aria-hidden="true" />
                    {benefit.amount}
                  </span>
                  <span
                    class:list={[
                      'text-body-5 md:text-right',
                      benefit.highlight ? 'font-semibold text-primary-900' : 'text-neutral-700',
                    ]}
                  >
                    {benefit.note}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="text-caption-1 text-neutral-700">
            혜택 꽃잎은 정식 오픈일부터 6개월 동안 쓸 수 있고, 현금으로 환불되지 않아요. 추천 꽃잎은 추천받은
            작가님이 첫 예약을 완료하면 지급돼요.
          </p>
        </section>

        <section id="how" class={sectionCls} aria-labelledby="how-title">
          <h2 id="how-title" class={h2Cls}>꽃잎은 예약이 확정될 때 한 번만 쓰여요</h2>
          <ol class="grid gap-5 md:grid-cols-3 md:gap-0">
            {
              steps.map((step, index) => (
                <li class="grid content-start gap-2 border-l-2 border-primary-200 pl-4 md:border-l md:px-6 md:first:border-l-0 md:first:pl-0">
                  <span class="text-[1.5rem] font-extrabold leading-none text-primary">{index + 1}</span>
                  <h3 class="text-[1.15rem] font-bold">{step.title}</h3>
                  <p class="text-body-5 text-neutral-700">{step.body}</p>
                  <span
                    class:list={[
                      'inline-flex items-center gap-1.5 text-body-4 font-bold tabular-nums',
                      step.spend ? 'text-petal-ink' : 'text-neutral-700',
                    ]}
                  >
                    {step.spend && <i class={petal} aria-hidden="true" />}
                    {step.cost}
                  </span>
                </li>
              ))
            }
          </ol>
        </section>

        <section class={sectionCls} aria-labelledby="calc-title">
          <h2 id="calc-title" class={h2Cls}>오픈 혜택으로 몇 달을 쓸 수 있을까요?</h2>
          <div class="grid items-center gap-7 rounded-lg border border-primary-200 bg-neutral-0 p-5 md:grid-cols-2 md:p-8">
            <div class="min-w-0">
              <label for="perMonth" class="mb-2.5 block font-semibold">한 달 예약 건수</label>
              <input id="perMonth" type="range" min="1" max={FREE_BOOKINGS} value="4" class="w-full accent-primary" aria-describedby="calcResult" />
              <div class="flex justify-between text-caption-2 text-neutral-700 tabular-nums">
                <span>1건</span><span>8건</span><span>{FREE_BOOKINGS}건</span>
              </div>
              <div id="petals" class="mt-2 flex flex-wrap gap-1" aria-hidden="true">
                {
                  Array.from({ length: FREE_BOOKINGS }, (_, i) => (
                    <i class:list={['block h-3.5 w-3.5 rounded-[70%_0_70%_0] bg-petal transition-opacity', i >= 4 && 'opacity-20']} />
                  ))
                }
              </div>
            </div>
            <div id="calcResult" class="grid min-w-0 gap-1.5" aria-live="polite">
              <p class="text-[2rem] font-extrabold leading-tight tracking-[-0.02em] md:text-[2.8rem]">
                약 <span id="months" class="text-petal-ink">4</span>개월
              </p>
              <p id="calcText" class="text-body-4 text-neutral-700">
                한 달 4건이면 {PETALS_TOTAL}꽃잎으로 4개월 동안 수수료 없이 예약을 받아요.
              </p>
            </div>
          </div>
          <p class="text-caption-1 text-neutral-700">
            선착순 1,000명 기준({PETALS_TOTAL}꽃잎, 건당 {PETALS_PER_BOOKING}꽃잎). 혜택 꽃잎의 사용 기한은
            오픈일부터 6개월이에요.
          </p>
        </section>

        <section class={sectionCls} aria-labelledby="promise-title">
          <h2 id="promise-title" class={h2Cls}>정직하게 쓰는 작가님이 손해 보지 않게</h2>
          <ul class="grid md:grid-cols-2 md:gap-x-10">
            {
              promises.map(({ Icon, title, body }) => (
                <li class="grid grid-cols-[auto_1fr] gap-x-3.5 gap-y-1 border-b border-primary-200 py-[18px] last:border-b-0 md:[&:nth-last-child(2)]:border-b-0">
                  <span class="row-span-2 mt-0.5 grid h-9 w-9 place-items-center rounded-md bg-primary-100 text-primary">
                    <Icon size={18} strokeWidth={2.2} aria-hidden="true" />
                  </span>
                  <h3 class="text-[1.05rem] font-bold">{title}</h3>
                  <p class="text-body-5 text-neutral-700">{body}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class={sectionCls} aria-labelledby="faq-title">
          <h2 id="faq-title" class={h2Cls}>자주 묻는 질문</h2>
          <div>
            {
              faqs.map((faq) => (
                <details class="group border-b border-primary-200 py-4">
                  <summary class="flex cursor-pointer list-none justify-between gap-3 font-semibold [&::-webkit-details-marker]:hidden">
                    {faq.q}
                    <span class="font-bold text-primary group-open:hidden" aria-hidden="true">+</span>
                    <span class="hidden font-bold text-primary group-open:inline" aria-hidden="true">−</span>
                  </summary>
                  <p class="mt-2.5 max-w-[40em] text-neutral-700">{faq.a}</p>
                </details>
              ))
            }
          </div>
        </section>

        <section
          id="signup"
          class="my-12 grid scroll-mt-4 items-start gap-7 rounded-xl bg-primary p-7 text-neutral-0 md:my-20 md:grid-cols-2 md:p-12"
          aria-labelledby="signup-title"
        >
          <div>
            <h2 id="signup-title" class={h2Cls}>사전등록하고<br />{PETALS_TOTAL}꽃잎 받기</h2>
            <p class="mt-2.5 text-primary-100">오픈하는 날 가입 안내와 함께 꽃잎을 넣어 드려요.</p>
          </div>

          <form id="signupForm" class="grid gap-2.5" novalidate>
            <label for="fa-name" class="sr-only">작가명</label>
            <input
              id="fa-name"
              name="name"
              type="text"
              maxlength="40"
              autocomplete="nickname"
              placeholder="작가명 (예: 봄날스냅)"
              required
              aria-describedby="err-name"
              class="w-full rounded-md bg-neutral-0 px-3.5 py-3 text-primary-900"
            />
            <p id="err-name" class="hidden text-caption-1 text-primary-100" data-error="name"></p>

            <label for="fa-insta" class="sr-only">인스타그램 계정</label>
            <input
              id="fa-insta"
              name="instagram"
              type="text"
              maxlength="80"
              autocomplete="off"
              placeholder="인스타그램 계정 (선택)"
              class="w-full rounded-md bg-neutral-0 px-3.5 py-3 text-primary-900"
            />

            <label for="fa-phone" class="sr-only">휴대폰 번호</label>
            <input
              id="fa-phone"
              name="phone"
              type="tel"
              inputmode="numeric"
              autocomplete="tel"
              maxlength="13"
              placeholder="휴대폰 번호 (010-1234-5678)"
              required
              aria-describedby="err-phone"
              class="w-full rounded-md bg-neutral-0 px-3.5 py-3 text-primary-900"
            />
            <p id="err-phone" class="hidden text-caption-1 text-primary-100" data-error="phone"></p>

            {/* 봇만 채우는 칸 — 사람에게는 보이지 않는다 */}
            <div class="hidden" aria-hidden="true">
              <label for="fa-website">웹사이트</label>
              <input id="fa-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <label class="mt-1 flex items-start gap-2 text-body-5">
              <input id="fa-consent" name="consent" type="checkbox" required class="mt-1 h-4 w-4 accent-neutral-0" />
              <span>개인정보 수집·이용에 동의해요 (필수)</span>
            </label>
            <details class="text-caption-1 text-primary-100">
              <summary class="cursor-pointer underline underline-offset-2">수집 항목과 보관 기간 보기</summary>
              <ul class="mt-2 list-disc space-y-0.5 pl-4">
                <li>수집 항목: 작가명, 휴대폰 번호, 인스타그램 계정(선택)</li>
                <li>이용 목적: 사전등록 확인, 오픈 안내 연락, 오픈 혜택 꽃잎 지급</li>
                <li>보관 기간: 정식 오픈 후 6개월까지. 삭제를 요청하면 바로 지워요</li>
                <li>동의하지 않을 수 있고, 이 경우 사전등록이 되지 않아요</li>
                <li>삭제 요청: dearbloom.qa@gmail.com</li>
              </ul>
            </details>
            <p id="err-consent" class="hidden text-caption-1 text-primary-100" data-error="consent"></p>

            <button
              id="fa-submit"
              type="submit"
              class="mt-1 min-h-11 rounded-lg bg-neutral-0 px-5 font-bold text-primary disabled:opacity-60"
            >
              사전등록 신청
            </button>
            <p id="fa-status" class="text-body-3 font-semibold" role="status" aria-live="polite"></p>
          </form>
        </section>
      </main>

      <footer class="flex flex-wrap justify-between gap-2 pb-10 pt-6 text-caption-1 text-neutral-700">
        <span>© DearBloom</span>
        <a href="/privacy-policy" class="underline underline-offset-2">개인정보처리방침</a>
      </footer>
    </div>

    <style>
      .fa-logo {
        -webkit-mask: url('/images/dearbloom-logo.svg') no-repeat center / contain;
        mask: url('/images/dearbloom-logo.svg') no-repeat center / contain;
      }
    </style>

    <script>
      const TOTAL = 200;
      const COST = 12;
      const WINDOW_MONTHS = 6;
      const bookings = Math.floor(TOTAL / COST);

      // ---- 계산기 ----
      const range = document.getElementById('perMonth') as HTMLInputElement;
      const monthsEl = document.getElementById('months') as HTMLElement;
      const calcText = document.getElementById('calcText') as HTMLElement;
      const petals = Array.from(document.querySelectorAll<HTMLElement>('#petals > i'));

      function updateCalc() {
        const perMonth = Number(range.value);
        const months = bookings / perMonth;
        const shown = months >= WINDOW_MONTHS ? WINDOW_MONTHS : Math.round(months * 10) / 10;
        monthsEl.textContent = String(shown);
        calcText.textContent =
          months >= WINDOW_MONTHS
            ? `한 달 ${perMonth}건이면 사용 기한 6개월 내내 수수료 없이 예약을 받아요.`
            : `한 달 ${perMonth}건이면 ${TOTAL}꽃잎으로 ${shown}개월 동안 수수료 없이 예약을 받아요.`;
        petals.forEach((el, index) => el.classList.toggle('opacity-20', index >= perMonth));
      }
      range.addEventListener('input', updateCalc);
      updateCalc();

      // ---- 휴대폰 번호 하이픈 ----
      const phone = document.getElementById('fa-phone') as HTMLInputElement;
      function formatPhone(value: string) {
        const d = value.replace(/\D/g, '').slice(0, 11);
        if (d.length < 4) return d;
        if (d.length < 8) return `${d.slice(0, 3)}-${d.slice(3)}`;
        if (d.length === 10) return `${d.slice(0, 3)}-${d.slice(3, 6)}-${d.slice(6)}`;
        return `${d.slice(0, 3)}-${d.slice(3, 7)}-${d.slice(7)}`;
      }
      phone.addEventListener('input', () => {
        const digitsBefore = phone.value.slice(0, phone.selectionStart ?? phone.value.length).replace(/\D/g, '').length;
        const formatted = formatPhone(phone.value);
        phone.value = formatted;
        let pos = 0;
        let seen = 0;
        while (pos < formatted.length && seen < digitsBefore) {
          if (/\d/.test(formatted[pos])) seen++;
          pos++;
        }
        phone.setSelectionRange(pos, pos);
      });

      // ---- 사전등록 전송 ----
      const form = document.getElementById('signupForm') as HTMLFormElement;
      const submit = document.getElementById('fa-submit') as HTMLButtonElement;
      const status = document.getElementById('fa-status') as HTMLElement;

      function showError(field: string, message: string) {
        const el = form.querySelector<HTMLElement>(`[data-error="${field}"]`);
        if (!el) {
          status.textContent = message;
          return;
        }
        el.textContent = message;
        el.classList.remove('hidden');
      }

      function clearErrors() {
        form.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
          el.textContent = '';
          el.classList.add('hidden');
        });
        status.textContent = '';
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearErrors();

        const data = new FormData(form);
        const name = String(data.get('name') ?? '').trim();
        const phoneDigits = String(data.get('phone') ?? '').replace(/\D/g, '');
        const consent = (document.getElementById('fa-consent') as HTMLInputElement).checked;

        let invalid = false;
        if (!name) {
          showError('name', '작가명을 입력해 주세요.');
          invalid = true;
        }
        if (!/^01\d{8,9}$/.test(phoneDigits)) {
          showError('phone', '휴대폰 번호를 010-1234-5678 형식으로 입력해 주세요.');
          invalid = true;
        }
        if (!consent) {
          showError('consent', '개인정보 수집·이용에 동의해 주세요.');
          invalid = true;
        }
        if (invalid) return;

        const params = new URLSearchParams(location.search);
        submit.disabled = true;
        submit.textContent = '보내는 중…';
        try {
          const response = await fetch('/api/artist-applications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              instagram: data.get('instagram'),
              phone: phoneDigits,
              consent,
              website: data.get('website'),
              utm_source: params.get('utm_source'),
              utm_medium: params.get('utm_medium'),
              utm_campaign: params.get('utm_campaign'),
              referrer: document.referrer || null,
            }),
          });
          const result = (await response.json().catch(() => ({}))) as { error?: string; field?: string };
          if (!response.ok) {
            showError(result.field ?? 'form', result.error ?? '보내지 못했어요. 잠시 후 다시 시도해 주세요.');
            submit.disabled = false;
            submit.textContent = '사전등록 신청';
            return;
          }
          form.querySelectorAll('input').forEach((input) => (input.disabled = true));
          submit.textContent = '신청 완료';
          status.textContent = '사전등록됐어요. 오픈하는 날 입력하신 번호로 안내드릴게요.';
        } catch {
          showError('form', '네트워크 오류로 보내지 못했어요. 다시 시도해 주세요.');
          submit.disabled = false;
          submit.textContent = '사전등록 신청';
        }
      });
    </script>
  </body>
</html>
