---
export const prerender = false; // 서버 렌더 (작품 상세를 요청 시 API 로 가져옴)

import { SaveHeart, RegionTag } from '@dearbloom/ui';
import { SnapDetailTabs } from '@/components/SnapDetailTabs';
import { DetailMoreCollapsible } from '@/components/DetailMoreCollapsible';
import { SnapShareButton } from '@/components/SnapShareButton';
import { getArtwork, fetchPublicWithAuthFallback, artistRegionLabel, type ArtworkDetail } from '@dearbloom/shared';

const { slug } = Astro.params;
const token = Astro.cookies.get('accessToken')?.value;

// 로그인별 isSaved 가 담기므로 CDN 공유 캐시 금지(익명 렌더가 로그인 사용자에게 새는 것 방지).
Astro.response.headers.set('Cache-Control', 'private, no-store');

let artwork: ArtworkDetail | null = null;
try {
  // 만료 토큰(401)이면 익명으로 재시도 → public 상세는 항상 노출(만료 쿠키 하나로 에러 방지).
  const { data, tokenExpired } = await fetchPublicWithAuthFallback((o) => getArtwork(slug!, o), token);
  artwork = data;
  if (tokenExpired) Astro.cookies.delete('accessToken', { path: '/' });
} catch (e) {
  // SSR 실패 원인은 서버 로그(Vercel Runtime Logs)에서 확인.
  console.error('[snaps/:id] getArtwork 실패', slug, e);
  artwork = null;
}

const won = (n: number) => `${n.toLocaleString()}원`;
const photos = artwork ? [...artwork.photoList].sort((a, b) => a.sortOrder - b.sortOrder) : [];

// 촬영 장소: schoolNameList 우선, 없으면 사진의 대학명에서 도출
const shootPlaces = artwork
  ? artwork.schoolNameList?.length
    ? artwork.schoolNameList
    : [...new Set(photos.map((p) => p.universityName).filter(Boolean))]
  : [];

// 촬영 인원 (min~max)
const headCount =
  artwork == null || artwork.minHeadCount == null
    ? ''
    : artwork.maxHeadCount != null
      ? `${artwork.minHeadCount}~${artwork.maxHeadCount}명`
      : `${artwork.minHeadCount}명 이상`;

const packages = artwork?.packageList ?? [];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{artwork?.title ?? '작품'} · dearBloom</title>
  </head>
  <body class="min-h-screen bg-neutral-100 font-sans text-neutral-950">
    {
      !artwork ? (
        <div class="flex min-h-screen flex-col items-center justify-center gap-4 px-6 text-center">
          <p class="text-body-5 text-neutral-600">작품을 찾을 수 없어요.</p>
          <a href="/snaps" class="rounded-md bg-primary px-5 py-2.5 text-body-6 text-neutral-0">작품 탐색으로</a>
        </div>
      ) : (
        <>
          {/* Header */}
          <header class="sticky top-0 z-20 flex h-[52px] items-center justify-between bg-neutral-0 px-2">
            <a href="/snaps" aria-label="뒤로가기" class="flex h-11 w-11 items-center justify-center text-neutral-950">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden><path d="m15 18-6-6 6-6" /></svg>
            </a>
            <h1 class="truncate text-head-3 text-neutral-950">작품 상세</h1>
            <div class="flex items-center">
              <div class="flex h-11 w-11 items-center justify-center">
                <SaveHeart artworkId={artwork.artworkId} initialSaved={!!artwork.isSaved} size={24} client:load />
              </div>
              <SnapShareButton client:load />
            </div>
          </header>

          {/* 상단 화이트 블록: 캐러셀 + 제목 + 탭 */}
          <div class="bg-neutral-0">
            {photos.length > 0 && (
              <div class="flex snap-x gap-1 overflow-x-auto px-2 pb-2">
                {photos.map((p) =>
                  p.fileType === 'VIDEO' ? (
                    <video src={p.fileUrl} class="aspect-[3/4] w-[190px] shrink-0 snap-start rounded-sm object-cover" controls />
                  ) : (
                    <img src={p.fileUrl} alt={artwork.title} loading="lazy" class="aspect-[3/4] w-[190px] shrink-0 snap-start rounded-sm object-cover" />
                  ),
                )}
              </div>
            )}

            {/* 제목 + 지역칩 + 작가 */}
            <div class="px-4 pt-3">
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                <h2 class="text-head-3 text-neutral-950">{artwork.title}</h2>
                {artwork.artist.regionList?.map((code) => (
                  <RegionTag>{artistRegionLabel(code)}</RegionTag>
                ))}
              </div>
              <p class="mt-1 text-body-6 text-neutral-800">{artwork.artist.nickname}</p>
            </div>

            {/* 인페이지 탭 (리뷰는 준비중) */}
            <SnapDetailTabs client:load />
          </div>

          <div class="pb-28 pt-4">
            {/* 작품 설명 */}
            {artwork.description && (
              <section class="mb-3">
                <h3 class="mb-2 px-4 text-head-3 text-neutral-800">작품 설명</h3>
                <div class="mx-4 rounded-lg bg-neutral-0 p-4">
                  <p class="whitespace-pre-line text-body-5 text-neutral-800">{artwork.description}</p>
                </div>
              </section>
            )}

            {/* 촬영 정보 */}
            {(shootPlaces.length > 0 || headCount) && (
              <section class="mb-3">
                <h3 class="mb-2 px-4 text-head-3 text-neutral-800">촬영 정보</h3>
                <div class="mx-4 rounded-lg bg-neutral-0 p-4">
                  <dl class="flex flex-col gap-3">
                    {shootPlaces.length > 0 && (
                      <div class="flex items-start justify-between gap-4">
                        <dt class="shrink-0 text-body-6 text-neutral-600">촬영 장소</dt>
                        <dd class="text-right text-body-5 text-neutral-950">{shootPlaces.join(', ')}</dd>
                      </div>
                    )}
                    {headCount && (
                      <div class="flex items-start justify-between gap-4">
                        <dt class="shrink-0 text-body-6 text-neutral-600">촬영 인원</dt>
                        <dd class="text-right text-body-5 text-neutral-950">{headCount}</dd>
                      </div>
                    )}
                  </dl>
                </div>
              </section>
            )}

            {/* 촬영 구성 (패키지 + 출장비) */}
            {(packages.length > 0 || artwork.artist.travelFee) && (
              <section class="mb-3">
                <h3 class="mb-2 px-4 text-head-3 text-neutral-800">촬영 구성</h3>
                <div class="mx-4 flex flex-col gap-3">
                  {packages.map((pkg) => (
                    <div class="rounded-lg bg-neutral-0 p-4">
                      <div class="flex items-center justify-between gap-3">
                        <span class="text-body-5 text-neutral-950">{pkg.packageName}</span>
                        <span class="shrink-0 text-body-1 font-semibold text-primary">{won(pkg.price)}</span>
                      </div>
                      <dl class="mt-3 flex flex-col gap-2 border-t border-neutral-200 pt-3">
                        <div class="flex items-start justify-between gap-4">
                          <dt class="text-body-6 text-neutral-600">촬영 시간</dt>
                          <dd class="text-body-5 text-neutral-950">{pkg.durationMinutes}분</dd>
                        </div>
                        <div class="flex items-start justify-between gap-4">
                          <dt class="text-body-6 text-neutral-600">보정본 수</dt>
                          <dd class="text-body-5 text-neutral-950">{pkg.finalPhotoCount}장</dd>
                        </div>
                        {pkg.extraInfo && (
                          <div class="flex items-start justify-between gap-4">
                            <dt class="shrink-0 text-body-6 text-neutral-600">추가</dt>
                            <dd class="text-right text-body-5 text-neutral-950">{pkg.extraInfo}</dd>
                          </div>
                        )}
                      </dl>
                    </div>
                  ))}

                  {/* 출장비 — 촬영 구성에 포함(Figma) */}
                  {artwork.artist.travelFee && (
                    <div class="rounded-lg bg-neutral-0 p-4">
                      <div class="flex items-start justify-between gap-4">
                        <span class="shrink-0 text-body-6 text-neutral-600">출장비</span>
                        <span class="whitespace-pre-line text-right text-body-5 text-neutral-950">{artwork.artist.travelFee}</span>
                      </div>
                      <p class="mt-2 text-caption-2 text-neutral-500">출장비는 모델의 위치와 촬영 장소에 따라 달라질 수 있습니다.</p>
                    </div>
                  )}
                </div>
              </section>
            )}

            {/* 상세 정보 — 기본 접힘, '상세 정보 더보기' 토글로 기타 안내 + 작가 소개 노출 (Figma) */}
            {(artwork.artist.etcInfo || artwork.artist.intro) && (
              <DetailMoreCollapsible
                etcInfo={artwork.artist.etcInfo}
                intro={artwork.artist.intro}
                nickname={artwork.artist.nickname}
                client:load
              />
            )}

            {/* 다른 작업 보기 */}
            {artwork.otherArtworkList?.length > 0 && (
              <section class="mb-3">
                <h3 class="mb-3 px-4 text-head-3 text-neutral-800">다른 작업 보기</h3>
                <div class="grid grid-cols-3 gap-2 px-4">
                  {artwork.otherArtworkList.map((o) => (
                    <a href={`/snaps/${o.artworkId}`} class="block">
                      <div class="aspect-[4/5] overflow-hidden rounded-md bg-neutral-300">
                        <img src={o.imageUrl} alt={o.title ?? ''} loading="lazy" class="h-full w-full object-cover" />
                      </div>
                      {o.title && <p class="mt-1 truncate text-body-6 text-neutral-950">{o.title}</p>}
                      {o.artistNickname && <p class="truncate text-caption-2 text-neutral-600">{o.artistNickname}</p>}
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>

          {/* 하단 액션바 — 스마트 문의 기능(백엔드 문의/채팅 API)은 준비 중이라 비활성 */}
          <div class="fixed inset-x-0 bottom-0 z-30 border-t border-neutral-200 bg-neutral-0 p-4">
            <div class="mx-auto max-w-md">
              <button type="button" disabled aria-disabled="true" title="준비 중" class="flex h-[52px] w-full items-center justify-center rounded-md bg-neutral-300 text-body-1 text-neutral-500">스마트 문의하기 (준비 중)</button>
            </div>
          </div>

        </>
      )
    }
  </body>
</html>
