---
export const prerender = false; // 서버 렌더 (작품 상세를 요청 시 API 로 가져옴)

import { AppToaster, FlashToast, NativeExitDialog, RegionTag } from '@dearbloom/ui';
import { SnapShareButton } from '@/components/SnapShareButton';
import { PackageList } from '@/components/PackageList';
import { SchoolChipsExpander } from '@/components/SchoolChipsExpander';
import { SnapMoreMenu } from '@/components/SnapMoreMenu';
import { SnapBackButton } from '@/components/SnapBackButton';
import { SmartInquiryCta } from '@/components/SmartInquiryCta';
import { getArtworkBackHref } from '@/lib/artworkReturnPath';
import { optimizedImageUrl } from '@/lib/imageUrl';
import {
  getArtwork,
  getArtworkReported,
  fetchPublicWithAuthFallback,
  artistRegionLabel,
  type ArtworkDetail,
} from '@dearbloom/shared';

const { slug } = Astro.params;
const token = Astro.cookies.has('onboardingPending')
  ? undefined
  : Astro.cookies.get('accessToken')?.value;
const backHref = getArtworkBackHref(Astro.url.searchParams.get('returnTo'));
const returnQuery = backHref === '/snaps' ? '' : `?returnTo=${encodeURIComponent(backHref)}`;
const imageGalleryHref = `/snaps/${slug}/images${returnQuery}`;

if (token) {
  // 로그인별 isSaved 가 담기므로 CDN 공유 캐시 금지(익명 렌더가 로그인 사용자에게 새는 것 방지).
  Astro.response.headers.set('Cache-Control', 'private, no-store');
} else {
  // 익명 렌더에는 개인 상태가 없다(isSaved 는 null) → CDN 에 짧게 올려 SEO·재방문 트래픽을 함수 없이 받는다.
  // Vary: Cookie 로 accessToken 을 든 요청이 이 익명 응답을 받지 않게 한다.
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
  Astro.response.headers.set('Vary', 'Cookie');
}

let artwork: ArtworkDetail | null = null;
try {
  const { data, tokenExpired } = await fetchPublicWithAuthFallback((o) => getArtwork(slug!, o), token);
  artwork = data;
  if (tokenExpired) Astro.cookies.delete('accessToken', { path: '/' });
} catch (e) {
  console.error('[snaps/:id] getArtwork 실패', slug, e);
  artwork = null;
}

const won = (n: number) => `${n.toLocaleString()}원`;
const photos = artwork ? [...artwork.photoList].sort((a, b) => a.sortOrder - b.sortOrder) : [];

// 촬영 경험 학교: schoolNameList 우선, 없으면 사진 대학명에서 도출
const shootPlaces = artwork
  ? artwork.schoolNameList?.length
    ? artwork.schoolNameList
    : ([...new Set(photos.map((p) => p.universityName).filter(Boolean))] as string[])
  : [];

const packages = artwork?.packageList ?? [];
const lowestPrice = packages.length > 0 ? Math.min(...packages.map((p) => p.price)) : null;

// 신고 여부 — 로그인 상태에서만 조회(실패해도 상세 노출을 막지 않는다).
let reported = false;
if (artwork && token) {
  reported = await getArtworkReported(artwork.artworkId, { token })
    .then((r) => r.reported)
    .catch(() => false);
}
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{artwork?.title ?? '작품'} · DearBloom</title>
  </head>
  <body class="min-h-screen bg-neutral-100 font-sans text-neutral-950">
    {
      !artwork ? (
        <div class="flex min-h-screen flex-col items-center justify-center gap-4 px-6 text-center">
          <p class="text-body-5 text-neutral-600">작품을 찾을 수 없어요.</p>
          <a href="/snaps" class="rounded-md bg-primary px-5 py-2.5 text-body-6 text-neutral-0">작품 탐색으로</a>
        </div>
      ) : (
        <>
          {/* Header */}
          {/* Figma header_title/Variant3 — 375x52, 좌우 여백 4, 뒤로가기 44x44(아이콘 28) + 우측 아이콘 2개(공유·더보기).
              저장(하트)은 헤더가 빽빽해져 하단 CTA 좌측으로 내렸다(QA, 디자이너 확정). */}
          <header class="sticky top-0 z-20 flex h-[52px] items-center justify-between bg-neutral-100 px-1">
            <SnapBackButton fallbackHref={backHref} client:idle />
            {/* 좌(44) 우(88) 폭이 달라 flex 흐름에 두면 가운데로 안 온다 — 헤더 전체 기준 중앙에 절대배치. */}
            <h1 class="pointer-events-none absolute inset-x-0 mx-auto w-max max-w-[60%] truncate text-center text-head-3 text-neutral-950">작품 상세</h1>
            <div class="flex items-center">
              <SnapShareButton title={artwork.title} kakaoKey={import.meta.env.NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY} client:idle />
              <SnapMoreMenu
                artworkId={artwork.artworkId}
                initialReported={reported}
                authenticated={!!token}
                client:idle
              />
            </div>
          </header>

          {/* 상단 블록: 캐러셀 + 제목 + 탭 (Figma 는 페이지 배경 그대로, 흰색은 정보 카드에만) */}
          <div>
            {/* scroll-pl-4: 스냅이 좌측 패딩을 건너뛰어 첫 장이 화면 끝에 붙는 것 방지 */}
            {/* bg-neutral-200: 사진이 오기 전까지 빈칸 대신 회색 자리로 (아래 '다른 작품' 그리드와 같은 처리) */}
            {photos.length > 0 && (
              <div class="flex snap-x scroll-pl-4 gap-1 overflow-x-auto px-4">
                {photos.map((p, i) =>
                  p.fileType === 'VIDEO' ? (
                    // preload=metadata: 재생 전에 본문까지 받지 않게 — 캐러셀에 여러 장이 깔릴 수 있다.
                    <video src={p.fileUrl} preload="metadata" class="aspect-[3/4] w-[190px] shrink-0 snap-start rounded-lg bg-neutral-200 object-cover" controls />
                  ) : (
                    /* 첫 장은 이 화면의 LCP — lazy 로 두면 발견이 한 박자 늦어지므로 eager + 높은 우선순위. */
                    <a href={imageGalleryHref} class="shrink-0 snap-start">
                      <img
                        src={optimizedImageUrl(p.fileUrl, 190)}
                        alt={artwork.title}
                        loading={i === 0 ? 'eager' : 'lazy'}
                        fetchpriority={i === 0 ? 'high' : undefined}
                        class="aspect-[3/4] w-[190px] rounded-lg bg-neutral-200 object-cover"
                      />
                    </a>
                  ),
                )}
              </div>
            )}

            {/* 제목 + 지역칩 + 작가 — Figma: 제목↔칩그룹 12, 칩끼리 4 */}
            <div class="px-4 pt-4">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <h2 class="text-head-1 text-neutral-900">{artwork.title}</h2>
                {artwork.artist.regionList?.length > 0 && (
                  <div class="flex flex-wrap items-center gap-1">
                    {artwork.artist.regionList.map((code) => (
                      <RegionTag>{artistRegionLabel(code)}</RegionTag>
                    ))}
                  </div>
                )}
              </div>
              <p class="mt-1 text-body-5 text-neutral-800">{artwork.artist.nickname}</p>
            </div>

          </div>

          <div class="pb-28 pt-4">
            {/* 작품 정보 — 기본 가격 + 촬영 경험 학교 (Figma) */}
            {(lowestPrice != null || shootPlaces.length > 0) && (
              <section class="mb-8">
                <h3 class="mb-2 px-5 text-head-3 font-bold text-neutral-900">작품 정보</h3>
                <div class="mx-4 rounded-md bg-neutral-0 p-5">
                  <dl class="flex flex-col gap-4">
                    {lowestPrice != null && (
                      <div class="flex items-center justify-between gap-4">
                        <dt class="text-body-5 text-neutral-800">기본 가격</dt>
                        <dd class="text-body-4 text-neutral-900">{won(lowestPrice)}</dd>
                      </div>
                    )}
                    {shootPlaces.length > 0 && (
                      <div class="flex items-start justify-between gap-4">
                        <dt class="shrink-0 text-body-5 text-neutral-800">촬영 경험 학교</dt>
                        <dd class="min-w-0 flex-1">
                          <SchoolChipsExpander schools={shootPlaces} client:visible />
                        </dd>
                      </div>
                    )}
                  </dl>
                </div>
              </section>
            )}

            {/* 패키지 구분 — 패키지 카드 리스트 + 더보기 토글 (Figma) */}
            {packages.length > 0 && (
              <section class="mb-8">
                <h3 class="mb-2 px-5 text-head-3 font-bold text-neutral-900">패키지 구분</h3>
                <PackageList packages={packages} client:visible />
              </section>
            )}

            {/* 출장비 안내 */}
            {artwork.artist.travelFee && (
              <section class="mb-8">
                <h3 class="mb-2 px-5 text-head-3 font-bold text-neutral-900">출장비 안내</h3>
                <div class="mx-4 rounded-md bg-neutral-0 p-5">
                  <p class="whitespace-pre-line text-body-5 text-neutral-700">{artwork.artist.travelFee}</p>
                </div>
              </section>
            )}

            {/* 이용 안내 — 작가 소개 + 작품 안내 통합 카드 (Figma) */}
            {(artwork.artist.intro || artwork.description) && (
              <section class="mb-8">
                <h3 class="mb-2 px-5 text-head-3 font-bold text-neutral-900">이용 안내</h3>
                <div class="mx-4 flex flex-col gap-6 rounded-md bg-neutral-0 p-5">
                  {artwork.artist.intro && (
                    <div class="flex flex-col gap-3">
                      <p class="text-body-3 text-neutral-900">작가 소개</p>
                      <p class="whitespace-pre-line text-body-5 text-neutral-700">{artwork.artist.intro}</p>
                    </div>
                  )}
                  {artwork.description && (
                    <div class="flex flex-col gap-3">
                      <p class="text-body-3 text-neutral-900">작품 안내</p>
                      <p class="whitespace-pre-line text-body-5 text-neutral-700">{artwork.description}</p>
                    </div>
                  )}
                </div>
              </section>
            )}

            {/* 이 작가의 다른 작품 (Figma: 최하단 가로 캐러셀, CTA 위) */}
            {artwork.otherArtworkList?.length > 0 && (
              <section class="mb-8">
                <h3 class="mb-2 px-5 text-head-3 font-bold text-neutral-900">이 작가의 다른 작품</h3>
                <div class="flex snap-x scroll-pl-4 gap-2 overflow-x-auto px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                  {artwork.otherArtworkList.map((o) => (
                    <a href={`/snaps/${o.artworkId}${returnQuery}`} class="block w-[137px] shrink-0 snap-start">
                      <div class="h-[177px] overflow-hidden rounded-md bg-neutral-300">
                        <img src={optimizedImageUrl(o.imageUrl, 137)} alt={o.title ?? ''} loading="lazy" class="h-full w-full object-cover" />
                      </div>
                      <div class="mt-2 px-1">
                        {o.title && <p class="truncate text-body-4 text-neutral-900">{o.title}</p>}
                        {o.artistNickname && <p class="mt-0.5 truncate text-caption-1 text-neutral-700">{o.artistNickname}</p>}
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>

          {/* 하단 sticky CTA — 패키지 선택 시트를 거쳐 next 앱 문의 플로우로 진입.
              CTA 는 이 화면의 주 동작이라 client:load 를 유지한다 — client:idle 은 load 이벤트를
              기다리므로 눌러도 시트가 안 열리는 구간이 생긴다. */}
          <SmartInquiryCta
            packages={packages}
            artworkId={artwork.artworkId}
            initialSaved={!!artwork.isSaved}
            client:load
          />
        </>
      )
    }
    <AppToaster client:load />
    <FlashToast client:load />
    {/* 앱 종료 확인 — RN WebView 안에서만 의미가 있어 client:native (브라우저엔 JS 를 안 보냄). */}
    <NativeExitDialog client:native />
  </body>
</html>
