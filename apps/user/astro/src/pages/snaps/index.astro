---
export const prerender = false; // 서버 렌더 (작품 목록을 요청 시 API 로 가져옴)

import AppShellLayout from '@/layouts/AppShellLayout.astro';
import { AppHeader, APP_HEADER_OFFSET, ArtworkCard } from '@dearbloom/ui';
import { getArtworks, fetchPublicWithAuthFallback, artistRegionLabel, type ArtworkListItem } from '@dearbloom/shared';

const token = Astro.cookies.get('accessToken')?.value;
// 로그인 시 저장상태(isSaved)를 반영 → per-user 렌더(공유 캐시 금지). 비로그인은 캐시 가능(SEO).
if (token) Astro.response.headers.set('Cache-Control', 'private, no-store');

let artworks: ArtworkListItem[] = [];
let loadFailed = false;
try {
  // 만료 토큰(401)이면 익명으로 재시도 → public 목록은 항상 노출(만료 쿠키 하나로 에러 방지).
  const { data, tokenExpired } = await fetchPublicWithAuthFallback((o) => getArtworks(o), token);
  artworks = data;
  if (tokenExpired) Astro.cookies.delete('accessToken', { path: '/' });
} catch (e) {
  // SSR 실패 원인은 서버 로그(Vercel Runtime Logs)에서 확인.
  console.error('[snaps] getArtworks 실패', e);
  loadFailed = true;
}
---

<AppShellLayout title="작품 탐색" navVariant="light">
  <AppHeader logoHref="/snaps" searchHref="/search" />

  <div class={`mx-auto max-w-md ${APP_HEADER_OFFSET}`}>
    {!loadFailed && artworks.length > 0 && (
      <div class="px-4 pb-3 pt-3">
        <span class="text-caption-1 text-neutral-600">전체 {artworks.length}</span>
      </div>
    )}

    {/* 작품 피드 */}
    {loadFailed ? (
      <p class="px-4 py-16 text-center text-body-4 text-neutral-500">작품을 불러오지 못했어요. 잠시 후 다시 시도해주세요.</p>
    ) : artworks.length === 0 ? (
      <p class="px-4 py-16 text-center text-body-4 text-neutral-500">아직 등록된 작품이 없어요.</p>
    ) : (
      <div class="grid grid-cols-2 gap-x-2 gap-y-5 px-4 pb-6">
        {artworks.map((a) => (
          <ArtworkCard
            artworkId={a.artworkId}
            title={a.title}
            artistNickname={a.artistNickname}
            price={a.lowestPrice}
            thumbnailUrl={a.thumbnailUrl}
            regions={a.artistRegionList?.map(artistRegionLabel)}
            initialSaved={!!a.isSaved}
            client:load
          />
        ))}
      </div>
    )}
  </div>
</AppShellLayout>
