# 공통값은 .env.local, Web Client ID와 WebView URL은 환경별 파일에 둡니다.
# EAS 빌드는 eas.json profile별 development/preview/production 환경값을 사용합니다.

# Google Cloud OAuth client IDs (public identifiers, not secrets)
# WEB client: 백엔드가 같은 환경의 client ID/secret으로 serverAuthCode를 교환해야 합니다.
# development (.env.development.local)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=220813497248-3rgsjldmn08ekvcb1239chknot4ns7oq.apps.googleusercontent.com
EXPO_PUBLIC_WEBVIEW_URL=https://dev.dearbloom.co.kr/snaps
# production (.env.production.local)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=220813497248-vv0o1p29cm39613mp7tfo8tl75mu2cq1.apps.googleusercontent.com
# EXPO_PUBLIC_WEBVIEW_URL=https://dearbloom.co.kr/snaps
# iOS client registered for kr.co.dearbloom.mobile.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=220813497248-0c60eajtj8oiuueorf89lc0p73u8t9re.apps.googleusercontent.com

# 푸시 알림(FCM, iOS 전용). 1 이면 Firebase 플러그인을 붙인다 — 아래 plist 가 있어야 prebuild 가 통과한다.
PUSH_ENABLED=1
# Firebase 프로젝트별 설정 파일. 브랜치가 아니라 이 값으로 dev/prod 를 고른다.
# 로컬·개발 빌드는 dev, EAS production profile 에서는 .prod 파일을 지정한다.
GOOGLE_SERVICES_PLIST=./GoogleService-Info.dev.plist
GOOGLE_SERVICES_JSON=./google-services.dev.json
