# 로컬은 이 파일을 .env.local로 복사하고 현재 HTTPS 터널 주소를 설정합니다.
# EAS 빌드는 eas.json profile별 development/preview/production 환경값을 사용합니다.
EXPO_PUBLIC_WEBVIEW_URL=https://your-local-tunnel.example/snaps

# Google Cloud OAuth client IDs (public identifiers, not secrets)
# WEB client: backend exchanges Google serverAuthCode with this client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=220813497248-3rgsjldmn08ekvcb1239chknot4ns7oq.apps.googleusercontent.com
# iOS client registered for kr.co.dearbloom.mobile.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# 푸시 알림(FCM, iOS 전용). 1 이면 Firebase 플러그인을 붙인다 — 아래 plist 가 있어야 prebuild 가 통과한다.
PUSH_ENABLED=1
# Firebase 프로젝트별 설정 파일. 브랜치가 아니라 이 값으로 dev/prod 를 고른다.
# 로컬·개발 빌드는 dev, EAS production profile 에서는 ./GoogleService-Info.prod.plist 를 지정한다.
GOOGLE_SERVICES_PLIST=./GoogleService-Info.dev.plist
