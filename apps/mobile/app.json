{
  "expo": {
    "name": "dearBloom",
    "slug": "dearbloom-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "dearbloom",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "kr.co.dearbloom.mobile",
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "졸업 스냅 촬영 및 사진 등록을 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "프로필 및 촬영 사진을 선택하기 위해 사진 보관함에 접근합니다.",
        "NSPhotoLibraryAddUsageDescription": "촬영하거나 저장한 사진을 사진 보관함에 저장하기 위해 사용합니다."
      }
    },
    "android": {
      "package": "kr.co.dearbloom.mobile",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#296A48"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "9f1decea-b9bd-4019-ba75-44e71622cd0f"
      }
    }
  }
}
