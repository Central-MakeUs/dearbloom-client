{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "expo start --clear",
    "dev:naver": "EXPO_PUBLIC_WEBVIEW_URL=https://m.naver.com expo start",
    "android": "ANDROID_HOME=$HOME/Library/Android/sdk expo run:android",
    "ios": "expo run:ios --no-build-cache --device",
    "ios:16pro": "expo run:ios --device \"iPhone 16 Pro\"",
    "ios:naver": "open -a Simulator && EXPO_PUBLIC_WEBVIEW_URL=https://m.naver.com expo run:ios",
    "test:back": "node --test nativeBack.test.mjs",
    "test:safe-area": "node --test nativeSafeArea.test.mjs",
    "test:deep-link": "node --test nativeDeepLink.test.mjs",
    "test:kakao": "node --test nativeKakao.test.mjs",
    "test:push": "node --test nativePush.test.mjs",
    "test:session": "node --test nativeSession.test.mjs",
    "test:share": "node --test nativeShare.test.mjs",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.3",
    "@notifee/react-native": "^9.1.8",
    "@preeternal/react-native-cookie-manager": "^6.4.0",
    "@react-native-firebase/app": "^26.2.0",
    "@react-native-firebase/messaging": "^26.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "~57.0.2",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.6",
    "expo-dev-client": "~57.0.5",
    "expo-splash-screen": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@dearbloom/config": "workspace:*",
    "@types/react": "^19.2.17",
    "eslint": "^9.15.0",
    "typescript": "^6.0.3"
  }
}
