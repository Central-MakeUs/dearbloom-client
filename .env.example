# 환경별 값 예시 — 실제 .env 는 gitignore.
# Vercel 각 프로젝트 Settings → Environment Variables 에서 관리.
#
# NEXT_PUBLIC_API_URL 예시
#   Production  → https://api.dearbloom.co.kr
#   Preview     → https://dev-api.dearbloom.co.kr
#   Development → http://localhost:8080
# Vercel Production/Preview 배포에서는 필수이며, 환경별로 별도 설정합니다.

NEXT_PUBLIC_API_URL=http://localhost:8080

# 로컬 Web ↔ 개발 Server 소셜 로그인 확인용
NEXT_PUBLIC_OAUTH_API_URL=https://dev-api.dearbloom.co.kr
NEXT_PUBLIC_LOCAL_GOOGLE_CALLBACK_URL=http://localhost:3000/app/api/auth/callback

# 프론트 도메인 (필요 시 참조)
#   Production  → https://dearbloom.co.kr
#   Preview     → https://dev.dearbloom.co.kr
#   Development → http://localhost:4321
NEXT_PUBLIC_ASTRO_URL=http://localhost:4321

# Kakao Developers 앱의 JavaScript 키. JavaScript SDK 도메인 등록도 필요합니다.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# 모바일 로컬 실행값은 apps/mobile/.env.local에서 관리합니다.

# 개발용 로그인(dev login) 활성화 여부. 프로덕션에서는 false 로 설정하세요.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
